{
  "name": "posturama",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "setup": "node scripts/ensure-mediapipe-assets.mjs",
    "predev": "npm run setup",
    "dev": "vite",
    "dev:netlify": "netlify dev",
    "prebuild": "npm run setup",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "uat": "node uat/run-uat.mjs",
    "check:deploy": "npm run build && node uat/check-subpath.mjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@mediapipe/tasks-vision": "1.0.1",
    "@netlify/blobs": "^11.0.3",
    "@netlify/functions": "^6.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "netlify-cli": "^27.4.3",
    "oxlint": "^1.79.0",
    "playwright-core": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
